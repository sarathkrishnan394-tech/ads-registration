# Copy this file's variable names into your Vercel project's
# Settings -> Environment Variables (Production, Preview, and Development).
# Do not commit a real .env file with actual values to git.

# Your Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=

# Your Supabase anon/public key (Project Settings -> API -> Project API keys -> anon public)
# This key is safe to expose to the browser as long as Row Level Security
# policies on the "responses" table only allow inserts, not reads/updates/deletes.
SUPABASE_ANON_KEY=
